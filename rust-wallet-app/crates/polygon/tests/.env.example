# polygon Phase 8 — environment configuration template (issue #518 / P8-T-setup)
#
# Operator copies this file to `.env` in the same directory
# (`rust-wallet-app/crates/polygon/tests/.env`) and edits values for
# their environment. Both `.env.example` and `.env` are gitignored by
# root `.gitignore` lines 14-17 (`**/.env` + `*.env` + `**/*.env`); the
# `.env.example` here is the committed template.
#
# `dotenvy::from_filename("tests/.env").ok()` loads this from
# `amoy_smoke.rs::ensure_dotenv_loaded()` (and from each future
# `amoy_*.rs` helper that needs env vars). Runs exactly once per
# test binary via `std::sync::OnceLock`. Missing-file errors are
# swallowed so CI/clean checkouts still compile (compile-only gate
# per plan AC #4); missing required keys (e.g. `AMOY_FUNDED_PK_HEX`
# when a PK-using test fires) panic at the call site instead.
#
# All Phase 8 tests are `#[ignore]` + operator-driven per L29 (manual
# run via `RUN_POLYGON_AMOY=1 cargo test -p polygon -- --ignored`).
# The defaults below match §Environment Configuration in
# `docs/superpowers/engineering/2026-09-02-polygon-amoy-test-plan.md`
# (the authoritative single source of truth for Phase 8 RPC + chain
# + address constants).

# ── Amoy testnet (primary; P8-T0..T5 + P8-T-manualfaucet all run here) ────────
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_CHAIN_ID=80002
POLYGON_USDC_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582

# ── Polygon mainnet (cross-chain replay only; P8-T4 G6 sig-binding proof) ───
POLYGON_MAINNET_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_MAINNET_CHAIN_ID=137
POLYGON_MAINNET_USDC_ADDRESS=0x3c499c542cef5e3811e1192ce70d8cc03d5c3359

# ── Test fixtures (deterministic Anvil #0 test vector; NOT a real secret) ────
# EIP-55 address: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Operators swap to their own funded PK for live runs. Tests that read
# this var use the Mutex-serialized pattern + immediate
# `std::env::remove_var()` after capture per L54.
AMOY_FUNDED_PK_HEX=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── Opt-in guards (L29 — never run live-testnet tests in CI) ────────────────
RUN_POLYGON_AMOY=1
RUN_POLYGON_MAINNET=1
