# btc-send-regtest-e2e.env.example — operator template for
# `btc-send-regtest-e2e.sh` (Issue #284).
#
# Usage:
#   1. cp this file to `btc-send-regtest-e2e.env`
#   2. Fill in real values (bitcoind auth, mnemonic)
#   3. chmod 600 btc-send-regtest-e2e.env
#   4. set -a; source ./btc-send-regtest-e2e.env; set +a
#   5. bash rust-wallet-app/scripts/btc-send-regtest-e2e.sh
#
# DO NOT commit the real `btc-send-regtest-e2e.env` (gitignored via .env wildcard).

# --- Master gate (set to 1 to enable) ---
BTC_E2E_REGTEST=1

# --- bitcoind RPC (regtest) ---
BTC_RPC_URL=http://localhost:18443
BTC_RPC_USER=foo
BTC_RPC_PASS=bar
BTC_RPC_CLI=bitcoin-cli

# --- Esplora (regtest) ---
BTC_ESPLORA_URL=http://localhost:50001/regtest/api

# --- Sender (use FILE form, never env, where possible) ---
# BTC_E2E_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
BTC_E2E_MNEMONIC_FILE=/path/to/mnemonic.txt

# --- Recipient (default: sender address — self-send) ---
# BTC_E2E_RECIPIENT=tb1q...

# --- Network / amount / fee ---
BTC_E2E_NETWORK=regtest
BTC_E2E_AMOUNT_SAT=100000
BTC_E2E_FEE_RATE_SAT_PER_VB=1

# --- Polling + funding ---
BTC_E2E_POLL_TIMEOUT=60
BTC_E2E_FUND_MIN_CONFIRMATIONS=1

# --- Build (optional) ---
# SKIP_BUILD=1
# BTC_BIN=/path/to/btc