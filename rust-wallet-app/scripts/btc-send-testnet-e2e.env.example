# btc-send-testnet-e2e.env.example — operator template for
# `btc-send-testnet-e2e.sh` (Issue #278).
#
# Usage:
#   1. cp this file to `btc-send-testnet-e2e.env`
#   2. Fill in real values
#   3. chmod 600 btc-send-testnet-e2e.env   (mnemonic is secret material — L12)
#   4. set -a; source ./btc-send-testnet-e2e.env; set +a
#   5. bash rust-wallet-app/scripts/btc-send-testnet-e2e.sh
#
# DO NOT commit the real `btc-send-testnet-e2e.env` (add to .gitignore).

# --- Master gate (set to 1 to enable E2E) ---
BTC_E2E_TESTNET=1

# --- Required: sender (use FILE form, never env, where possible) ---
# BIP-39 phrase (12/15/18/21/24 words). SECURITY: visible in env dumps.
# Prefer BTC_E2E_MNEMONIC_FILE below.
# BTC_E2E_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# Path to mnemonic file (mode 0o600). Mutually exclusive with BTC_E2E_MNEMONIC.
BTC_E2E_MNEMONIC_FILE=/path/to/mnemonic.txt

# --- Required: recipient (testnet BIP-21) ---
BTC_E2E_RECIPIENT=tb1q...

# --- Required: faucet (operator-driven funding step) ---
BTC_E2E_FAUCET_URL=https://coinfaucet.eu/btc/testnet/

# --- Optional (defaults shown) ---
# Send amount in satoshis.
BTC_E2E_AMOUNT_SAT=10000

# Fee rate (sat/vB). Default 1 if neither this nor BTC_E2E_FEE_TARGET_BLOCKS is set.
# BTC_E2E_FEE_RATE_SAT_PER_VB=1

# Pick from `btc fee-estimates` at closest target. Examples: 1, 3, 6, 144, 1008.
# Set to e.g. 6 to target "next ~hour" confirmation.
# BTC_E2E_FEE_TARGET_BLOCKS=6

# Esplora base URL (HTTPS-only per F36).
BTC_E2E_ESPLORA_URL=https://blockstream.info/testnet/api

# F20 SPKI pin (required for non-regtest per F20 enforcement).
# Get via: openssl x509 -in blockstream.info.pem -pubkey -noout | \
#     openssl pkey -pubin -outform der | openssl dgst -sha256 -hex
# BTC_E2E_SPKI_PIN=...

# Confirmation poll timeout (seconds; ~10 min for 1 conf on testnet).
BTC_E2E_POLL_TIMEOUT=600

# Sub-gate: single | multi | drain | bumfee | all
BTC_E2E_MODE=single

# Incremental step enable for gate_single (debug aid):
#   0 = btc wallet balance only (default; safe, no broadcast)
#   1 = + btc wallet send (captures txid)
#   2 = + poll until confirmed
#   3 = + assert recipient paid (full original flow)
BTC_E2E_STEP=0