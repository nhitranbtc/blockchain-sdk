# e2e-regtest.env.example — operator template for the regtest E2E stack
# (Issue #284 / PR #285).
#
# Source this BEFORE running the stack + the script:
#   set -a; source scripts/e2e-regtest.env.example; set +a
#   bash scripts/e2e-regtest/up.sh
#   bash scripts/btc-send-regtest-e2e.sh
#
# DO NOT commit the real `e2e-regtest.env` (gitignored via .env wildcard).

# --- Container names (must match docker-compose.yml `container_name`) ---
E2E_BITCOIND_CONTAINER=e2e-bitcoind-regtest
E2E_ESPLORA_CONTAINER=e2e-esplora-regtest

# --- bitcoind RPC ---
BTC_RPC_URL=http://localhost:18443
BTC_RPC_USER=foo
BTC_RPC_PASS=bar
BTC_RPC_CLI=bitcoin-cli
# Script auto-routes bitcoin-cli through `docker exec -i <container>` when set.
BTC_DOCKER_CONTAINER=e2e-bitcoind-regtest

# --- Esplora HTTP API ---
BTC_ESPLORA_URL=http://localhost:50001/regtest/api

# --- btc CLI ---
# Build first: cargo build -p btc
BTC_BIN=/path/to/btc

# --- Sender (operator-supplied) ---
# Use FILE form (mode 0o600) for real keys; the example below is a
# well-known test vector, NOT a real wallet. Generate fresh for any
# real operation.
BTC_E2E_MNEMONIC="<12-or-24-word-test-vector>"
# BTC_E2E_MNEMONIC_FILE=/path/to/mnemonic.txt

# --- E2E knobs ---
BTC_E2E_REGTEST=1
BTC_E2E_NETWORK=regtest
BTC_E2E_AMOUNT_SAT=100000
BTC_E2E_FEE_RATE_SAT_PER_VB=1
BTC_E2E_POLL_TIMEOUT=60
BTC_E2E_FUND_MIN_CONFIRMATIONS=1
# BTC_E2E_RECIPIENT defaults to sender address (self-send) when unset.

# --- Stack lifecycle (called by up.sh / down.sh; listed here for reference) ---
# bash scripts/e2e-regtest/up.sh
# bash scripts/e2e-regtest/down.sh           # keep volumes
# bash scripts/e2e-regtest/down.sh --volumes  # wipe state