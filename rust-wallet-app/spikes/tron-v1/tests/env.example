# Schema for tests/.env (local-only Nile testnet creds).
#
# Real file gitignored via `*.local` (root .gitignore). Copy this template
# to `.env` (or `nile-creds.local`) and fill values before running e2e:
#
#   cp tests/env.example tests/.env
#   set -a; source tests/.env; set +a
#   cargo test -p tron-v1-spike \
#     --test use_case_alpha_sends_beta_100_usdt \
#     use_case_alpha_sends_beta_100_usdt_live_nile \
#     -- --ignored --nocapture

# Sender private key (hex, 32 bytes, secp256k1). Fund via Nile faucet.
TRON_NILE_PRIVATE_KEY=

# Recipient T-base58check address on Nile testnet.
TRON_NILE_RECIPIENT_ADDRESS=

# SHA-256 (hex) of Nile fullnode TLS SubjectPublicKeyInfo. Pins cert to defeat rogue-CA MITM.
# Get current pin:
#   openssl s_client -connect nile.trongrid.io:443 -servername nile.trongrid.io \
#     | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der \
#     | openssl dgst -sha256 -hex
TRON_NILE_SPKI_PIN=

# USDT-TRC20 contract address on Nile (testnet mirror of mainnet USDT).
TRON_NILE_USDT_TOKEN_ADDRESS=